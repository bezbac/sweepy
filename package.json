{
  "name": "sweepy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sweepy": "./dist/cli.js"
  },
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "knip": "knip",
    "prepare": "effect-language-service patch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.6",
    "@effect/vitest": "4.0.0-beta.97",
    "@types/node": "^24.0.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.0",
    "rolldown": "^1.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1"
}
