{
  "name": "sweepy",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "sweepy": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "knip": "knip",
    "pack": "bash ./build-release-package.sh",
    "prepare": "effect-tsgo patch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm format && pnpm knip && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "diff": "^9.0.0",
    "effect": "4.0.0-beta.97",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@effect/vitest": "4.0.0-beta.97",
    "@types/node": "^24.0.0",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1"
}
